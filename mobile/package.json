{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "check:api": "node ../scripts/check-backend-health.mjs",
    "start": "node ../scripts/warn-if-backend-down.mjs && expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios",
    "run:ios:device": "expo run:ios --device",
    "build:ios:preview": "eas build --profile preview --platform ios",
    "build:ios:dev": "eas build --profile development --platform ios",
    "web": "expo start --web",
    "verify:routes": "node ./scripts/verify-expo-routes.mjs && npx tsx --test src/features/agent/calendar/googleCalendarOAuthCallback.test.ts",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:calendar-intelligence": "npx tsx --test src/features/agent/calendarIntelligence/calendarIntelligence.test.ts src/features/agent/calendarIntelligence/calendarExactTimeReadDetection.test.ts src/features/agent/calendarIntelligence/calendarReadTimeIntent.test.ts",
    "test:calendar-update": "npx tsx --test src/features/agent/calendar/calendarUpdate.test.ts",
    "test:calendar-delete": "npx tsx --test src/features/agent/calendar/calendarDelete.test.ts",
    "test:calendar-create": "npx tsx --test src/features/agent/calendar/calendarCreate.test.ts",
    "test:calendar-create-past-time": "npx tsx --test src/features/agent/calendar/calendarCreatePastTime.test.ts",
    "test:calendar-reliability": "npx tsx --test src/features/agent/calendar/calendarReliabilityAcceptance.test.ts",
    "test:calendar-date-parser": "npx tsx --test src/features/agent/calendarIntelligence/calendarNaturalDateParser.test.ts",
    "test:calendar-mutation-reliability": "npx tsx --test src/features/agent/calendar/calendarMutationReliability.test.ts src/features/agent/calendar/calendarExecutionHonesty.test.ts",
    "test:calendar-mutation-verification": "npx tsx --test src/features/agent/calendar/calendarMutationVerificationHonesty.test.ts",
    "test:calendar-read-delete-pronoun": "npx tsx --test src/features/agent/calendar/calendarReadToDeletePronoun.test.ts",
    "test:calendar-reschedule": "npx tsx --test src/features/agent/calendar/calendarReschedule.test.ts",
    "test:calendar-real-user-regression": "npx tsx --test src/features/agent/calendar/calendarRealUserRegression.test.ts",
    "test:calendar-ru-uk-schedule": "npx tsx --test src/features/agent/calendar/calendarRuUkSchedule.test.ts",
    "test:calendar-conflict": "npx tsx --test src/features/agent/calendar/calendarScheduleConflict.test.ts src/features/agent/calendar/calendarCreateConflictDetection.test.ts src/features/agent/calendar/calendarConflictConfirmation.test.ts src/features/agent/calendar/calendarConflictRejectionFlow.test.ts src/features/agent/calendar/calendarConflictAlternativeSlots.test.ts",
    "test:calendar-conversation": "npx tsx --test src/features/agent/calendar/calendarConversationState.test.ts src/features/agent/calendar/calendarPendingReplyClassifier.test.ts",
    "test:calendar-create-intent": "npx tsx --test src/features/agent/calendar/calendarCreateByTitleTime.test.ts",
    "test:calendar-create-recurrence": "npx tsx --test src/features/agent/calendar/calendarCreateRecurrence.test.ts",
    "test:calendar-conversation-intelligence": "npx tsx --test src/features/agent/calendar/calendarConversationIntelligence.test.ts",
    "test:calendar-spoken-time": "npx tsx --test src/features/agent/calendar/calendarSpokenTime.test.ts",
    "test:calendar-conflict-resolution": "npx tsx --test src/features/agent/calendar/calendarConflictResolution.test.ts src/features/agent/calendar/calendarConversationState.test.ts",
    "test:calendar-event-memory": "npx tsx --test src/features/agent/calendar/calendarConversationEventMemory.test.ts src/features/agent/calendar/calendarEventReferenceTokens.test.ts src/features/agent/calendar/calendarConversationMemorySchedule.test.ts src/features/agent/calendar/calendarPendingIntent.test.ts src/features/agent/calendar/calendarConversationContextRetention.test.ts",
    "test:calendar-conflict-ux": "npx tsx --test src/features/agent/calendar/calendarConflictUx.test.ts",
    "test:calendar-stabilization": "npx tsx --test src/features/agent/calendar/calendarStabilization.test.ts src/features/agent/calendar/calendarUpdateEventResolution.test.ts src/features/agent/calendar/calendarConversationMemoryFlow.test.ts src/features/agent/calendar/calendarAuthUserReplies.test.ts src/features/agent/calendar/calendarDisambiguation.test.ts src/features/agent/calendar/calendarDeleteDisambiguationFlow.test.ts",
    "test:calendar-query": "npx tsx --test src/features/agent/calendar/calendarQueryEngine.test.ts src/features/agent/calendar/calendarSpokenTime.test.ts src/features/agent/calendarIntelligence/calendarReadTimeIntent.test.ts",
    "test:calendar-time-range": "npx tsx --test src/features/agent/calendar/calendarTimeRange.test.ts",
    "test:calendar-duration-until": "npx tsx --test src/features/agent/calendar/calendarDurationUntil.test.ts",
    "test:calendar-reminder-engine": "npx tsx --test src/features/calendar-reminder-engine/calendarReminderEngine.test.ts",
    "test:local-reminders": "npx tsx --test src/features/local-reminders/localReminder.test.ts src/features/local-reminders/localReminderVoicePlayback.test.ts",
    "test:local-alarms": "npx tsx --test src/features/local-alarms/localAlarm.test.ts src/features/local-alarms/localAlarmSession.test.ts src/features/local-alarms/localAlarmVoiceText.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@tanstack/react-query": "^5.100.14",
    "expo": "^54.0.0",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-auth-session": "~7.0.11",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
