APP_ENV=development
EXPO_PUBLIC_APP_NAME=AI Executive Assistant
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api
EXPO_PUBLIC_APP_API_KEY=
EXPO_PUBLIC_ENABLE_REALTIME=false
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=10000
# Disabled automatically in Expo Go; enabled in dev client when client IDs are set.
EXPO_PUBLIC_GOOGLE_CALENDAR_ENABLED=true
EXPO_PUBLIC_GOOGLE_CALENDAR_WEB_CLIENT_ID=
# Required for Android dev client OAuth (Create Credentials → Android in Google Cloud Console).
EXPO_PUBLIC_GOOGLE_CALENDAR_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CALENDAR_IOS_CLIENT_ID=
EXPO_PUBLIC_CALENDAR_TIMEZONE=America/Chicago
EXPO_PUBLIC_CALENDAR_REMINDER_DEV_TEST=0
